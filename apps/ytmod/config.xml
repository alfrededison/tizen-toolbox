<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns:tizen="http://tizen.org/ns/widgets" xmlns="http://www.w3.org/ns/widgets" id="https://github.com/alfrededison/tizen-toolbox/ytmod" version="0.1.2" viewmodes="maximized">
    <access origin="*" subdomains="true"></access>
    <tizen:allow-navigation href="*"/>
    <tizen:application id="TboxYtMod1.YouTube" package="TboxYtMod1" required_version="3.0"/>
    <author href="https://github.com/alfrededison/tizen-toolbox">tizen-toolbox</author>
    <content src="ui/index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <feature name="http://tizen.org/feature/web.service"/>
    <icon src="icon.png"/>
    <name>YT Mod</name>
    <tizen:metadata key="http://samsung.com/tv/metadata/html5.4k.support" value="true"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/application.info"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/screensaver"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:service id="TboxYtMod1.YtModService">
        <tizen:content src="service/dist/index.js"/>
        <tizen:name>YtModService</tizen:name>
        <tizen:description>Relaunches YT Mod in debug mode and injects the userscript</tizen:description>
    </tizen:service>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
